  <CubeBlocks>
    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>SlopedCornerBase4mm</SubtypeId>
      </Id>
      <DisplayName>AWG 4mm Sloped Corner Base (Misc Slopes)</DisplayName>
      <Icon>NewIcons\MiscSlopes4.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <Model>Models\Cubes\Small\AWGSlopedCornerBase.mwm</Model>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <Components>
        <Component Subtype="InteriorPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="InteriorPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>2</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>1</PCU>
      <BlockVariants>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlopedCornerTip4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlopedCorner4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlabRaisedCornerSplit4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>InvertedCornerTip4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>InvertedCornerBase4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlabCornerSplit4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
