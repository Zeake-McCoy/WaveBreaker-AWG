<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    
    <!--Corner split flat base/tip start-->
    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>AWGInvertedCorner4mm</SubtypeId>
      </Id>
      <DisplayName>Inverted Corner 4mm (Plate Group Additions)</DisplayName>
      <Description>Start of a group acting as a group for some useful plates that would go in the larger, 'main' plate groups.</Description>
      <Icon>NewIcons\MissingPlates4mm.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <Model>Models\Cubes\Small\AWGInvertedCorner.mwm</Model>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <Components>
        <Component Subtype="InteriorPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="InteriorPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>2</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>1</PCU>

      <BlockVariants>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGInvertedCornerPlate4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGCorner4mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGQuarterCorner4mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGQuarterCornerSlopePlateLeft4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGQuarterCornerSlopePlateRight4mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGOffsetQuarterSlope4mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGOffsetQuarterSlopeFiller4mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGOffsetQuarterSlopePlate4mm</SubtypeId>
        </BlockVariant>
          
        <BlockVariant>
