        </BlockVariant>
      </BlockVariants>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <UseModelIntersection>true</UseModelIntersection>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>2</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>1</PCU>
    </Definition>
    
