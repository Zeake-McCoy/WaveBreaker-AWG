<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    
    <!--Corner split flat base/tip start-->
    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>AWGInvertedCorner50mm</SubtypeId>
      </Id>
      <DisplayName>Inverted Corner 50mm (Plate Group Additions)</DisplayName>
      <Description>Start of a group acting as a group for some useful plates that would go in the larger, 'main' plate groups.</Description>
      <Icon>NewIcons\MissingPlates50mm.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <Model>Models\Cubes\Small\AWGInvertedCorner.mwm</Model>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>2</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>1</PCU>

      <BlockVariants>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGInvertedCornerPlate50mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGCorner50mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGQuarterCorner50mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGQuarterCornerSlopePlateLeft50mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGQuarterCornerSlopePlateRight50mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGOffsetQuarterSlope50mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGOffsetQuarterSlopeFiller50mm</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGOffsetQuarterSlopePlate50mm</SubtypeId>
        </BlockVariant>
          
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
