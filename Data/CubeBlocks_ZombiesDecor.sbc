<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <Definition xsi:type="MyObjectBuilder_CargoContainerDefinition">
      <Id>
        <TypeId>CargoContainer</TypeId>
        <SubtypeId>BarrelStorage</SubtypeId>
      </Id>
      <DisplayName>AWG Barrel Stowage (1x1 Cargo Container)</DisplayName>
      <Icon>NewIcons\Stowage2.png</Icon>
      <Description>Description_SmallCargoContainer</Description>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="3" z="2" />
      <UseModelIntersection>true</UseModelIntersection>
      <Public>true</Public>
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\BarrelStorage.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="1" />
        <Component Subtype="SteelPlate" Count="3" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="InteriorPlate" Count="1" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>6</BuildTimeSeconds>
      <DamageMultiplierExplosion>1.5</DamageMultiplierExplosion>
      <EdgeType>Light</EdgeType>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>10</PCU>
      <IsAirTight>true</IsAirTight>
    </Definition>
      
  <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>AWGGrindableDoor1</SubtypeId>
      </Id>
      <DisplayName>AWG Wooden Door (Centred)</DisplayName>
      <Description>Door that can be welded to open it</Description>
      <Icon>NewIcons\Stowage1.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\DoorStage2AOpen.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="25" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="25" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="1"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>0.1</DamageMultiplierExplosion> 
      <DisassembleRatio>4</DisassembleRatio>
      <PowerConsumptionIdle>0.0001</PowerConsumptionIdle>
      <PowerConsumptionMoving>0.0001</PowerConsumptionMoving>
      <UseModelIntersection>true</UseModelIntersection>
      <Subparts>
        <SubpartDefinition>
          <Name>DoorClosed</Name>
        </SubpartDefinition>
      </Subparts>
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs>
          <Move>Rotate</Move>
          <!--Slide for linear-->
          <RotationAxis>Y</RotationAxis>
          <PivotPosition x="-0.7281" y="-0.26195" z="0.19036"/>
          <MaxOpen>-90</MaxOpen>
          <Speed>100</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
    
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.75" File="Models\Cubes\small\DoorStage1AClosed.mwm" />
        <Model BuildPercentUpperBound="0.99" File="Models\Cubes\small\DoorStage2AOpen.mwm" />
      </BuildProgressModels>
    
      <PCU>10</PCU>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>

  <BlockVariants>
        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>AWGWoodenDoorFlat</SubtypeId>
        </BlockVariant>
      </BlockVariants>
    
    </Definition>

    <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>AWGWoodenDoorFlat</SubtypeId>
      </Id>
      <DisplayName>AWG Wooden Door (Offset)</DisplayName>
      <Description>Door that can be welded to open it</Description>
      <Icon>NewIcons\Stowage1.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\WoodenDoorFlat.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="25" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="25" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="1"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>6</BuildTimeSeconds>
      <DamageMultiplierExplosion>0.1</DamageMultiplierExplosion>
      <DisassembleRatio>1.5</DisassembleRatio>
      <PowerConsumptionIdle>0.0001</PowerConsumptionIdle>
      <PowerConsumptionMoving>0.0001</PowerConsumptionMoving>
      <UseModelIntersection>true</UseModelIntersection>
      <Subparts>
        <SubpartDefinition>
          <Name>DoorClosedOffset</Name>
        </SubpartDefinition>
      </Subparts>
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs>
          <Move>Rotate</Move>
          <!--Slide for linear-->
          <RotationAxis>Y</RotationAxis>
          <PivotPosition x="-0.7281" y="-0.26195" z="-0.80464"/>
          <MaxOpen>-90</MaxOpen>
          <Speed>100</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>

      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.75" File="Models\Cubes\small\DoorStage1AClosed.mwm" />
        <Model BuildPercentUpperBound="0.99" File="Models\Cubes\small\DoorStage2AOpen.mwm" />
      </BuildProgressModels>

      <PCU>10</PCU>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>

    </Definition>

  </CubeBlocks>
</Definitions>