<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>   
    <Definition>
      <Id>
        <TypeId>Wheel</TypeId>
        <SubtypeId>OffroadWheel</SubtypeId>
      </Id>
      <Public>true</Public>
      <DisplayName>AWG Offroad Wheel 3x3</DisplayName>
      <Icon>NewIcons\OffroadWheel.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="1" z="3" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\small\OffroadWheel00.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <PhysicalMaterial>Wheel</PhysicalMaterial>
      <Components>
        <Component Subtype="SteelPlate" Count="2" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      
      <CriticalComponent Subtype="SteelPlate" Index="0" />

      <VoxelPlacement>
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0.01</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>
      
      
      <BlockPairName>OffroadWheel</BlockPairName>
      <DeformationRatio>0.3</DeformationRatio>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <Public>true</Public>
      <BuildTimeSeconds>4</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <GeneralDamageMultiplier>0.5</GeneralDamageMultiplier>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <DamageEffectId>212</DamageEffectId>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>OffroadSuspension</SubtypeId>
      </Id>
      <DisplayName>AWG Offroad Suspension 3x3</DisplayName>
      <Icon>NewIcons\OffroadWheelSuspension3x3.png</Icon>
      <CubeSize>Small</CubeSize>
      <GuiVisible>true</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\OffroadSuspension.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
      <DeformationRatio>0.1</DeformationRatio>
      <UsesDeformation>false</UsesDeformation>

      <BlockVariants>
        
        <BlockVariant>
          <TypeId>Wheel</TypeId>
          <SubtypeId>OffroadWheel</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>MotorSuspension</TypeId>
          <SubtypeId>OffroadSuspension2x2</SubtypeId>
        </BlockVariant>
          
        <BlockVariant>
          <TypeId>Wheel</TypeId>
          <SubtypeId>OffroadWheel2x2</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorSuspension</TypeId>
          <SubtypeId>OffroadSuspension25x25</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>Wheel</TypeId>
          <SubtypeId>OffroadWheel25x25</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorSuspension</TypeId>
          <SubtypeId>OffroadSuspension4x4</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>Wheel</TypeId>
          <SubtypeId>OffroadWheel4x4</SubtypeId>
        </BlockVariant>
        
      </BlockVariants>
      
      <Components>
        <Component Subtype="SteelPlate" Count="2" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SmallTube" Count="2" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <VoxelPlacement>
        <!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0.01</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <PrimarySound>BlockWheel1x1</PrimarySound>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.21</RequiredPowerInput>
      <RequiredIdlePowerInput>0.002</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <RotorPart>OffroadWheel</RotorPart>
      <PropulsionForce>1420</PropulsionForce>
      <MinHeight>-0.4</MinHeight>
      <MaxHeight>0.2</MaxHeight>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>20000</AxleFriction>
      <SteeringSpeed>0.015</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>50</PCU>
    </Definition>
    
