<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>IRSpotlight</SubtypeId>
      </Id>
      <DisplayName>IR Spotlight</DisplayName>
      <Icon>NewIcons\IRSpotlight.png</Icon>
      <Description>Long range, low intensity, wide cone</Description>
      <CubeSize>Small</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\IRSpotlight.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="LargeTube" Count="1" />
        <Component Subtype="InteriorPlate" Count="1" />
        <Component Subtype="Construction" Count="1" />
        <Component Subtype="BulletproofGlass" Count="2" />
      </Components>
      
      <BlockVariants>

        <BlockVariant>
          <TypeId>ReflectorLight</TypeId>
          <SubtypeId>HighIntensitySpotlight</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>ReflectorLight</TypeId>
          <SubtypeId>ArmouredLight</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>ReflectorLight</TypeId>
          <SubtypeId>ArmouredLightOffset</SubtypeId>
        </BlockVariant>
        
      </BlockVariants>
      
      <CriticalComponent Subtype="Construction" Index="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>3</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <LightRadius Min="0" Max="0" Default="0" />
      <LightReflectorRadius Min="30" Max="400" Default="300" />
      <LightFalloff Min="1" Max="3" Default="1.5" />
      <LightIntensity Min="0.1" Max="1" Default="0.5" />
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.0125</RequiredPowerInput>
      <Flare>SpotlightSmall</Flare>
      <ReflectorThickness>2</ReflectorThickness>
      <ReflectorTexture>Textures\Lights\reflector_small.dds</ReflectorTexture>
      <ReflectorConeDegrees>70</ReflectorConeDegrees>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
      <DestroySound>PoofExplosionCat2</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>HighIntensitySpotlight</SubtypeId>
      </Id>
      <DisplayName>High Intensity Spotlight</DisplayName>
      <Icon>NewIcons\IRSpotlight.png</Icon>
      <Description>A high power, small cone light</Description>
      <CubeSize>Small</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\IRSpotlight.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="3" />
        <Component Subtype="LargeTube" Count="2" />
        <Component Subtype="InteriorPlate" Count="2" />
        <Component Subtype="Construction" Count="4" />
        <Component Subtype="BulletproofGlass" Count="1" />
      </Components>
      <CriticalComponent Subtype="Construction" Index="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>15</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <LightRadius Min="0" Max="0" Default="0" />
      <LightReflectorRadius Min="100" Max="800" Default="400" />
      <LightFalloff Min="1" Max="3" Default="1.5" />
      <LightIntensity Min="5" Max="10" Default="0.5" />
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.400</RequiredPowerInput>
      <Flare>SpotlightSmall</Flare>
      <ReflectorThickness>2</ReflectorThickness>
      <ReflectorTexture>Textures\Lights\reflector_small.dds</ReflectorTexture>
      <ReflectorConeDegrees>10</ReflectorConeDegrees>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
      <DestroySound>PoofExplosionCat2</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>ArmouredLight</SubtypeId>
      </Id>
      <DisplayName>Armoured Light</DisplayName>
      <Icon>NewIcons\ArmouredLight.png</Icon>
      <Description>Description_ReflectorLight</Description>
      <CubeSize>Small</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\ArmouredLight.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="InteriorPlate" Count="1" />
        <Component Subtype="Construction" Count="1" />
      </Components>
      <CriticalComponent Subtype="Construction" Index="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>3</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <LightRadius Min="0" Max="0" Default="0" />
      <LightReflectorRadius Min="0" Max="100" Default="100" />
      <LightFalloff Min="0" Max="3" Default="1.5" />
      <LightIntensity Min="0.1" Max="1" Default="0.5" />
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.0025</RequiredPowerInput>
      <Flare>SpotlightSmall</Flare>
      <ReflectorThickness>1</ReflectorThickness>
      <ReflectorTexture>Textures\Lights\reflector_small.dds</ReflectorTexture>
      <ReflectorConeDegrees>30</ReflectorConeDegrees>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
      <DestroySound>PoofExplosionCat2</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>ArmouredLightOffset</SubtypeId>
      </Id>
      <DisplayName>Armoured Light (Offset)</DisplayName>
      <Icon>NewIcons\ArmouredLight.png</Icon>
      <Description>Description_ReflectorLight</Description>
      <CubeSize>Small</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\ArmouredLightOffset.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="InteriorPlate" Count="1" />
        <Component Subtype="Construction" Count="1" />
      </Components>
      <CriticalComponent Subtype="Construction" Index="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>3</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <LightRadius Min="0" Max="0" Default="0" />
      <LightReflectorRadius Min="0" Max="100" Default="100" />
      <LightFalloff Min="0" Max="3" Default="1.5" />
      <LightIntensity Min="0.1" Max="1" Default="0.5" />
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <RequiredPowerInput>0.0025</RequiredPowerInput>
      <Flare>SpotlightSmall</Flare>
      <ReflectorThickness>1</ReflectorThickness>
      <ReflectorTexture>Textures\Lights\reflector_small.dds</ReflectorTexture>
      <ReflectorConeDegrees>30</ReflectorConeDegrees>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
      <DestroySound>PoofExplosionCat2</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>
  </CubeBlocks>

  <EmissiveColorStatePresets>
    <EmissiveColorStatePreset>
      <Id>
        <TypeId>MyObjectBuilder_EmissiveColorStatePresetDefinition</TypeId>
        <SubtypeId>AWGEmissive</SubtypeId>
      </Id>
      <EmissiveStates>
        <EmissiveState StateName="Damaged" EmissiveColorName="Black" DisplayColorName="Black" Emissivity="0" />
        <EmissiveState StateName="Disabled" EmissiveColorName="Black" DisplayColorName="Black" Emissivity="0" />
        <EmissiveState StateName="Working" EmissiveColorName="White" DisplayColorName="White" Emissivity="2" />
        <EmissiveState StateName="Warning" EmissiveColorName="White" DisplayColorName="White" Emissivity="2" />
      </EmissiveStates>
    </EmissiveColorStatePreset>
  </EmissiveColorStatePresets>
</Definitions>