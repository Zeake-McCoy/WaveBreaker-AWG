<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>   
    <Definition>
      <Id>
        <TypeId>Wheel</TypeId>
        <SubtypeId>SpringWheel1x1</SubtypeId>
      </Id>
      <Public>true</Public>
      <DisplayName>AWG Spring Wheel 1x1</DisplayName>
      <Icon>NewIcons\SpringWheel1x1.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\small\SpringWheel1x1.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <PhysicalMaterial>Wheel</PhysicalMaterial>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      
      <CriticalComponent Subtype="SteelPlate" Index="0" />

      <VoxelPlacement>
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0.01</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>
      
      
      <BlockPairName>SpringWheel1x1</BlockPairName>
      <DeformationRatio>0.3</DeformationRatio>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <Public>true</Public>
      <BuildTimeSeconds>4</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <DamageEffectId>212</DamageEffectId>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
    </Definition>

    <Definition>
      <Id>
        <TypeId>Wheel</TypeId>
        <SubtypeId>SpringWheel15x15</SubtypeId>
      </Id>
      <Public>true</Public>
      <DisplayName>AWG Spring Wheel 1.5x1.5</DisplayName>
      <Icon>NewIcons\SpringWheel15x15.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\small\SpringWheel15x15a.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <PhysicalMaterial>Wheel</PhysicalMaterial>
      <Components>
        <Component Subtype="SteelPlate" Count="5" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SteelPlate" Count="3" />
      </Components>

      <CriticalComponent Subtype="SteelPlate" Index="0" />

      <VoxelPlacement>
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0.01</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>


      <BlockPairName>SpringWheel15x15</BlockPairName>
      <DeformationRatio>0.3</DeformationRatio>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <Public>true</Public>
      <BuildTimeSeconds>4</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <DamageEffectId>212</DamageEffectId>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
    </Definition>
    
    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>SpringSuspension1x1</SubtypeId>
      </Id>
      <DisplayName>AWG Spring Wheel Suspension 1x1</DisplayName>
      <Icon>NewIcons\SpringWheelSuspension1x1.png</Icon>
      <CubeSize>Small</CubeSize>
      <GuiVisible>true</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\SpringSuspension1x100.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
      <DeformationRatio>0.1</DeformationRatio>
      <UsesDeformation>false</UsesDeformation>

      <BlockVariants>
        
        <BlockVariant>
          <TypeId>Wheel</TypeId>
          <SubtypeId>SpringWheel1x1</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorSuspension</TypeId>
          <SubtypeId>SpringSuspension15x15</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>Wheel</TypeId>
          <SubtypeId>SpringWheel15x15</SubtypeId>
        </BlockVariant>
        
      </BlockVariants>
      
      <Components>
        <Component Subtype="SteelPlate" Count="2" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SmallTube" Count="2" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <VoxelPlacement>
        <!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0.01</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <!--<MirroringBlock>JetSuspensionMirrorSmall</MirroringBlock>-->
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <PrimarySound>BlockWheel1x1</PrimarySound>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.15</RequiredPowerInput>
      <RequiredIdlePowerInput>0.002</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <RotorPart>SpringWheel1x1</RotorPart>
      <PropulsionForce>800</PropulsionForce>
      <MinHeight>-0.3</MinHeight>
      <MaxHeight>0.3</MaxHeight>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>16000</AxleFriction>
      <SteeringSpeed>0.015</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>50</PCU>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>SpringSuspension15x15</SubtypeId>
      </Id>
      <DisplayName>AWG Spring Suspension 1.5x1.5</DisplayName>
      <Icon>NewIcons\SpringWheelSuspension15x15.png</Icon>
      <CubeSize>Small</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\SprocketSuspensionOffsetFurther01.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
      <DeformationRatio>0.1</DeformationRatio>
      <UsesDeformation>false</UsesDeformation>
      <Components>
        <Component Subtype="SteelPlate" Count="3" />
        <Component Subtype="Construction" Count="8" />
        <Component Subtype="SmallTube" Count="3" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />

      <VoxelPlacement>
        <!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0</MinAllowed>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
          <MaxAllowed>0.2</MaxAllowed>
          <MinAllowed>0.01</MinAllowed>
        </DynamicMode>
      </VoxelPlacement>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion>
      <PrimarySound>BlockWheel1x1</PrimarySound>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.1</RequiredPowerInput>
      <RequiredIdlePowerInput>0.0001</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <RotorPart>SpringWheel15x15</RotorPart>
      <PropulsionForce>1400</PropulsionForce>
      <MinHeight>-0.6</MinHeight>
      <MaxHeight>0.6</MaxHeight>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>22500</AxleFriction>
      <SteeringSpeed>0.015</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>50</PCU>
    </Definition>

