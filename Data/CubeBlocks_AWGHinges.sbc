<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_MotorAdvancedStatorDefinition">
      <Id>
        <TypeId>MotorAdvancedStator</TypeId>
        <SubtypeId>AWGHinge</SubtypeId>
      </Id>
      <BlockPairName>AWGHinge</BlockPairName>
      <DisplayName>AWG Thin Hinge Base</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\AWGThinHingeBase.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\small\AWGHingeStator.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="3" />
        <Component Subtype="Construction" Count="5" />
        <Component Subtype="SmallTube" Count="1" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <BuildTimeSeconds>8</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <UseModelIntersection>true</UseModelIntersection>
      <RotorPart>AWGHingeRotor</RotorPart>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.0002</RequiredPowerInput>
      <MaxForceMagnitude>1E6</MaxForceMagnitude>
      <DangerousTorqueThreshold>448000</DangerousTorqueThreshold>
      <RotorDisplacementMin>-0.01</RotorDisplacementMin>
      <RotorDisplacementMax>0.01</RotorDisplacementMax>
      <RotorDisplacementMinSmall>-0.01</RotorDisplacementMinSmall>
      <RotorDisplacementMaxSmall>0.01</RotorDisplacementMaxSmall>
      <RotorDisplacementInModel>0</RotorDisplacementInModel>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <DamageEffectId>212</DamageEffectId>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRotorSmall</PrimarySound>
      <PCU>175</PCU>
    </Definition>

    <Definition>
      <Id>
        <TypeId>MotorAdvancedRotor</TypeId>
        <SubtypeId>AWGHingeRotor</SubtypeId>
      </Id>
      <BlockPairName>AWGHingeRotor</BlockPairName>
      <DisplayName>AWG Thin Hinge Head</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\AWGThinHingeHead.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\small\AWGHingeRotor.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="12" />
        <Component Subtype="SmallTube" Count="6" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <BuildTimeSeconds>3</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <PCU>25</PCU>
    </Definition>
    
  </CubeBlocks>
</Definitions>