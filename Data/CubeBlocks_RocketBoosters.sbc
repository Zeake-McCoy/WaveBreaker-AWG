<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!--HydrogenThrusters-->

    <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
      <Id>
        <TypeId>Thrust</TypeId>
        <SubtypeId>Raptor</SubtypeId>
      </Id>
      <DisplayName>Raptor Engine (224t Lift)</DisplayName>
      <Icon>NewIcons\RaptorEngineASL.png</Icon>
      <Description>A high thrust engine with high fuel usage to go with it. Becomes more powerful at lower atmospheric densities. Currently without sound.</Description>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="3" z="6" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\RocketEngines\Raptor11.mwm</Model>
      <ThrusterType>Hydrogen</ThrusterType>
      <SilenceableByShipSoundSystem>false</SilenceableByShipSoundSystem>
      <Components>
        <Component Subtype="SteelPlate" Count="27" />
        <Component Subtype="Construction" Count="20" />
        <Component Subtype="MetalGrid" Count="22" />
        <Component Subtype="LargeTube" Count="10" />
        <Component Subtype="Construction" Count="10" />
        <Component Subtype="SteelPlate" Count="18" />
      </Components>
      <CriticalComponent Subtype="LargeTube" Index="0" />
      <Center x="1" y="1" z="5" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\RocketEngines\RaptorConstructionFirst.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\RocketEngines\RaptorConstructionSecond.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\RocketEngines\RaptorConstructionThird.mwm" />
      </BuildProgressModels>
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>29</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <FuelConverter>
        <FuelId>
          <TypeId>GasProperties</TypeId>
          <SubtypeId>Hydrogen</SubtypeId>
        </FuelId>
        <Efficiency>0.1</Efficiency>
      </FuelConverter>
      <MaxPowerConsumption>0.6</MaxPowerConsumption>
      <MinPowerConsumption>0.000000001</MinPowerConsumption>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <ForceMagnitude>2200000</ForceMagnitude>
      <SlowdownFactor>1</SlowdownFactor>

      <MinPlanetaryInfluence>0.2</MinPlanetaryInfluence>
      <MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
      <EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
      <EffectivenessAtMaxInfluence>0.75</EffectivenessAtMaxInfluence>

      <FlameDamageLengthScale>1.3</FlameDamageLengthScale>
      <FlameLengthScale>1.15</FlameLengthScale>
      <FlameIdleColor>
        <X>0.486</X>
        <Y>0.635</Y>
        <Z>0.933</Z>
        <W>-0.1</W>
      </FlameIdleColor>
      <FlameFullColor>
        <X>1.412</X>
        <Y>1.2</Y>
        <Z>1.804</Z>
        <W>0.95</W>
      </FlameFullColor>
      <FlamePointMaterial>RaptorThrustMiddle</FlamePointMaterial>
      <FlameLengthMaterial>RaptorThrustMiddle</FlameLengthMaterial>
      <FlameFlare>LargeGridLargeThruster</FlameFlare>
      <FlameVisibilityDistance>10000</FlameVisibilityDistance>
      <FlameGlareQuerySize>2.5</FlameGlareQuerySize>
      <PrimarySound>RaptorLoopASL</PrimarySound>
      <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
      <DamagedSound>ParticleWeapExpl</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>15</PCU>
        <TieredUpdateTimes>
            <unsignedInt>100</unsignedInt>
            <unsignedInt>3600</unsignedInt>
            <unsignedInt>0</unsignedInt>
        </TieredUpdateTimes>
    </Definition>
  </CubeBlocks>
</Definitions>
