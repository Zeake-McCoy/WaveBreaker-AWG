        </BlockVariant>
      </BlockVariants>
      
      <CriticalComponent Subtype="SteelPlate" Index="1" />
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>3</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <EdgeType>Light</EdgeType>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0</RequiredPowerInput>
      <OverlayTexture>Textures\GUI\Screens\CupolaCam.dds</OverlayTexture>
      <UseModelIntersection>true</UseModelIntersection>
      <MinFov>0.4</MinFov>
      <MaxFov>0.9</MaxFov>
      <Public>true</Public>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyed_Small</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>15</PCU>
    </Definition>

