        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>ThermalPortCubeNoOverlay</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionRoofHalf</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFlatHalfReverse</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFlatHalfTarget</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFlatHalfTargetReverse</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFixedPeriscopeBack</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFixedPeriscopeFront</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFixedPeriscopeCovered</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFixedPeriscopeCoveredOffset</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFixedPeriscopeSmallerBack</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>VisionFixedPeriscopeSmallerFront</SubtypeId>
        </BlockVariant>
