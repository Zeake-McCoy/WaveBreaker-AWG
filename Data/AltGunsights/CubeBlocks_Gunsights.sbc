<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_CameraBlockDefinition">
      <Id>
        <TypeId>CameraBlock</TypeId>
        <SubtypeId>GunCamAlt</SubtypeId>
      </Id>
      <DisplayName>Gunsight Camera Alt (Regular)</DisplayName>
      <Icon>NewIcons\AltGunsight.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\AltGunsight.mwm</Model>
      
      <Components>
        <Component Subtype="Computer" Count="1" />
      </Components>
     
      <CriticalComponent Subtype="Computer" Index="0" />
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>5</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <GeneralDamageMultiplier>0.25</GeneralDamageMultiplier>
      <EdgeType>Light</EdgeType>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0</RequiredPowerInput>
      <OverlayTexture>NewScreens\NewGunsight.dds</OverlayTexture>
      <MinFov>0.25</MinFov>
      <MaxFov>0.25</MaxFov>
      <Public>true</Public>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyed_Small</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>25</PCU>

      <BlockVariants>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>GunCamAltLeft</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>GunCamAltRight</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>GunCamAltOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>GunCamAltOffsetLeft</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>GunCamAltOffsetRight</SubtypeId>
        </BlockVariant>
      </BlockVariants>
      
    </Definition>

