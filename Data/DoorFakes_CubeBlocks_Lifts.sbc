        <Opening>
          <IDs>0</IDs>
          <Move>Slide</Move>
          <SlideDirection x="0" y="0" z="1" />
          <MaxOpen>0.69995</MaxOpen>

          <Speed>1</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
