      <Model>Models\Cubes\Small\TowerLift1Doors_005.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="15" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="15" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>6</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion>
      <DisassembleRatio>1.5</DisassembleRatio>
      <PowerConsumptionIdle>0.0001</PowerConsumptionIdle>
      <PowerConsumptionMoving>0.001</PowerConsumptionMoving>
      <BlockPairName>TowerLift1Doors</BlockPairName>
      <UseModelIntersection>false</UseModelIntersection>
      <Subparts>
        <!--<SubpartDefinition>
