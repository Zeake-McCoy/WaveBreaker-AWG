<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>Lift1Rails</SubtypeId>
      </Id>
      <DisplayName>Lift Rails (5 Tall)</DisplayName>
      <Description>Lift/Elevator</Description>
      <Icon>NewIcons\Stowage1.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="5" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Public>false</Public>
      <Model>Models\Cubes\Small\Lift1Rails.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="100" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="100" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>60</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DisassembleRatio>1.5</DisassembleRatio>
      <PowerConsumptionIdle>0.0001</PowerConsumptionIdle>
      <PowerConsumptionMoving>0.001</PowerConsumptionMoving>
      <BlockPairName>Lift1Rails</BlockPairName>
      <UseModelIntersection>false</UseModelIntersection>
      <Subparts>
        <SubpartDefinition>
          <Name>Lift1</Name>
        </SubpartDefinition>
      </Subparts>
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs>
          <Move>Slide</Move>
          <SlideDirection x="0" y="1" z="0" />
          <MaxOpen>10</MaxOpen><!--metres-->
          <Speed>1</Speed>
          <OpenDelay>0.00</OpenDelay>
          <CloseDelay>0.00</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
      <PCU>10</PCU>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>TowerLift1</SubtypeId>
      </Id>
      <DisplayName>Tower Lift (13 Tall)</DisplayName>
      <Description>Lift/Elevator, place doors on the bottom/top, lights around the shaft to keep carriage illuminated!</Description>
      <Icon>NewIcons\TowerLift.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="13" z="1" />
      <ModelOffset x="0" y="-15" z="0" />
      <Public>true</Public>
      <Model>Models\Cubes\Small\TowerLift1.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="100" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="100" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>60</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion>
      <DisassembleRatio>1.5</DisassembleRatio>
      <PowerConsumptionIdle>0.0001</PowerConsumptionIdle>
      <PowerConsumptionMoving>0.001</PowerConsumptionMoving>
      <BlockPairName>TowerLift1</BlockPairName>
      <UseModelIntersection>false</UseModelIntersection>
      <Subparts>
        <!--<SubpartDefinition>
          <Name>DoorLeft</Name>
        </SubpartDefinition>
        <SubpartDefinition>
          <Name>DoorRight</Name>
        </SubpartDefinition>-->
        <SubpartDefinition>
          <Name>SwingDoor</Name>
        </SubpartDefinition>
      </Subparts>
      <!--
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs>
          <Move>Slide</Move>
          <SlideDirection x="0" y="0" z="1" />
          <MaxOpen>0.69995</MaxOpen>

          <Speed>1</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
      
      <OpeningSequence>
        <Opening>
          <IDs>1</IDs>
          <Move>Slide</Move>
          <SlideDirection x="0" y="0" z="1" />
          <MaxOpen>1.45495</MaxOpen>

          <Speed>1</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
          -->
      
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs> <!--This could either be for the order this set of actions happens in, or for deciding which subpart in the subpart list to use. Switch to the subpart list idea if it is needed.-->
          <Move>Slide</Move>
          <SlideDirection x="0" y="1" z="0" />
          <MaxOpen>30</MaxOpen>
          <!--metres-->
          <Speed>2</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
      
      
      
      <PCU>10</PCU>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <EmissiveColorPreset>Extended</EmissiveColorPreset>
      
      <BlockVariants>
        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TowerLift1Doors</SubtypeId>
        </BlockVariant>
      </BlockVariants>
    
    </Definition>

    <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>TowerLift1Doors</SubtypeId>
      </Id>
      <DisplayName>Tower Lift Doors</DisplayName>
      <Description>Doors</Description>
      <Icon>NewIcons\TowerLiftDoors.png</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
