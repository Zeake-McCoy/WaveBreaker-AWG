  <CubeBlocks>
    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>E100SkirtSideLeft</SubtypeId>
      </Id>
      <DisplayName>300mm E-100 Skirt</DisplayName>
      <Icon>NewIcons\E100SkirtSideLeft.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="2" z="4" />
      <ModelOffset x="0" y="0" z="0" />
      <Center x="0" y="1" z="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <Model>Models\Cubes\Small\E100SkirtSideLeft1.mwm</Model>
      <BlockVariants>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>E100SkirtFrontLeft</SubtypeId>
        </BlockVariant>
          
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>E100SkirtBackLeft</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>E100SkirtFrontRight</SubtypeId>
        </BlockVariant>
          
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>E100SkirtBackRight</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>FrontSlopeHalfConversion</SubtypeId>
        </BlockVariant>
        
          <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>E100Track</SubtypeId>
        </BlockVariant>
       
         
      
      </BlockVariants>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <Components>
        <Component Subtype="SteelPlate" Count="24" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>2</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>BlockDestroyed_Medium</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>1</PCU>
    </Definition>

