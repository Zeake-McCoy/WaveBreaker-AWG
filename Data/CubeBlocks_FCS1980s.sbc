<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!--FCS START-->
    <Definition xsi:type="MyObjectBuilder_CameraBlockDefinition">
      <Id>
        <TypeId>CameraBlock</TypeId>
        <SubtypeId>FCSAltCamNew</SubtypeId>
      </Id>
      <DisplayName>FCS-Alt Camera (Regular)</DisplayName>
      <Icon>NewIcons\FCSCam.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\FCSCam.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <UseModelIntersection>true</UseModelIntersection>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      
      <Description>
        'Older' version of FCS with different overlay, meant for use with a separate rangefinder.
        
        Ranging (m):
        
        Top of crosshair bottom line:
        HE 310 (300)
        AP 480 (500)
        APDS 1080 (1100)
        APFSDS 4500
        
        Bottom of crosshair bottom line:
        HE 610 (600)
        AP 950  (1000)
        APDS 2150 (2200)
        APFSDS 8600
      </Description>
      
      <BuildTimeSeconds>5</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <EdgeType>Light</EdgeType>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0</RequiredPowerInput>
      <OverlayTexture>NewScreens\ModernSightNoRange.dds</OverlayTexture>
      <MinFov>0.2</MinFov>
      <MaxFov>0.6</MaxFov>
      <Public>true</Public>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyed_Small</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>25</PCU>

      <BlockVariants>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>FCSAltCamNewLeft</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>FCSAltCamNewRight</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>FCSAltCamNewOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>FCSAltCamNewOffsetLeft</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>FCSAltCamNewOffsetRight</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CameraBlock</TypeId>
          <SubtypeId>RangeFinderLate</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>RingMantlet</SubtypeId>
        </BlockVariant>
      </BlockVariants>
      
    </Definition>

