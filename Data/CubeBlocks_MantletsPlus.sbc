  <CubeBlocks>
    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>MantletTubeFiller</SubtypeId>
      </Id>
      <DisplayName>Mantlet Tube Filler</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\MantletPlate.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0.5" z="0" />
      <Model>Models\Cubes\Small\MantletTubeFiller.mwm</Model>
      <BlockVariants>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>MantletTubeFillerOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>MantletTubeEnd</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>MantletTubeEndOffset</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>MantletTubeCap</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>MantletTubeCapOffset</SubtypeId>
        </BlockVariant>
        
      </BlockVariants>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <UseModelIntersection>true</UseModelIntersection>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>2</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>BlockDestroyedExplosion_Tiny</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>1</PCU>
    </Definition>

