	<CubeBlocks>
		<Definition>
		  <Id>
			<TypeId>CubeBlock</TypeId>
			<SubtypeId>100mm4x1CornerFillerBaseLeft</SubtypeId>
		  </Id>
		  <DisplayName>100mm 4x1 Corner Filler Base (Left, Misc Slopes Plus)</DisplayName>
		  <Icon>NewIcons\MiscSlopesPlus100mmNew.png</Icon>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\NewPlates\4x1CornerFillerBaseLeft.mwm</Model>
		  <IsStandAlone>true</IsStandAlone>
		  <HasPhysics>true</HasPhysics>
		  <UseModelIntersection>true</UseModelIntersection>
		  <Components>
			<Component Subtype="SteelPlate" Count="8" />
		  </Components>
      <Public>true</Public>
		  <CriticalComponent Subtype="SteelPlate" Index="0" />
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>5</BuildTimeSeconds>
      <ExplosiveDamageMultiplier>1</ExplosiveDamageMultiplier> 
		  <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
		  <DestroySound>PoofExplosionCat1</DestroySound>
		  <PCU>1</PCU>
		  <BlockVariants>
		  
			<BlockVariant>
			  <TypeId>CubeBlock</TypeId>
			  <SubtypeId>100mm4x1CornerFillerBaseRight</SubtypeId>
			</BlockVariant>
			
