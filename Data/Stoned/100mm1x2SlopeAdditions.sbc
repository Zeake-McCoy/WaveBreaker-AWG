	<CubeBlocks>
		<Definition>
			<Id>
			<TypeId>CubeBlock</TypeId>
			<SubtypeId>100mmOffset1x2SlopeTip</SubtypeId>
		  </Id>
		  <DisplayName>100mm Offset 1x2 Slope Tip (2 Slope Additions)</DisplayName>
		  <Icon>NewIcons\1x2SlopeAdditions100mm.png</Icon>
		  <CubeSize>Small</CubeSize>
		  <BlockTopology>TriangleMesh</BlockTopology>
		  <Size x="1" y="1" z="1" />
		  <ModelOffset x="0" y="0" z="0" />
		  <Model>Models\NewPlates\Offset1x2SlopeTip.mwm</Model>
		  <IsStandAlone>true</IsStandAlone>
		  <HasPhysics>true</HasPhysics>
		  <UseModelIntersection>true</UseModelIntersection>
		  <Components>
			<Component Subtype="SteelPlate" Count="8" />
		  </Components>
		  <CriticalComponent Subtype="SteelPlate" Index="0" />
		  <MirroringY>Z</MirroringY>
		  <MirroringZ>Y</MirroringZ>
		  <EdgeType>Light</EdgeType>
		  <BuildTimeSeconds>5</BuildTimeSeconds>
      <ExplosiveDamageMultiplier>1</ExplosiveDamageMultiplier> 
		  <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
		  <DestroySound>PoofExplosionCat1</DestroySound>
		  <PCU>1</PCU>
		  <BlockVariants>
		  
