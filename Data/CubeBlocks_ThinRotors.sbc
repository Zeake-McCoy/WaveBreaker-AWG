    <Definition xsi:type="MyObjectBuilder_MotorStatorDefinition">
      <Id>
        <TypeId>MotorStator</TypeId>
        <SubtypeId>AWGMinimalHingeBase</SubtypeId>
      </Id>
      <DisplayName>AWG's Minimal Flat Hinge Base</DisplayName>
      <Icon>NewIcons\HingeBase.png</Icon>

      <Description>A flattened sideways rotor with centralised head; may cause physics issues, skilled builders only, and save often!</Description>

      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\AWGMinimalHingeBase.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="2" />
        <Component Subtype="Construction" Count="5" />
        <Component Subtype="SmallTube" Count="1" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="1" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <PrimarySound>BlockRotorSmall</PrimarySound>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.0002</RequiredPowerInput>
      <MaxForceMagnitude>1E6</MaxForceMagnitude>
      <DangerousTorqueThreshold>448001</DangerousTorqueThreshold>
      <RotorPart>AWGFlatHingeHead</RotorPart>

      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <UseModelIntersection>true</UseModelIntersection>

      <RotorDisplacementMin>-0.25</RotorDisplacementMin>
      <RotorDisplacementMax>0.25</RotorDisplacementMax>
      <RotorDisplacementMinSmall>-0.25</RotorDisplacementMinSmall>
      <RotorDisplacementMaxSmall>0.25</RotorDisplacementMaxSmall>
      <RotorDisplacementInModel>0</RotorDisplacementInModel>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>100</PCU>
      <IsAirTight>false</IsAirTight>
    
      <BlockVariants>
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatHingeBase</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>FlatHingePlateBase</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGMinimalHingeBaseCentred</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatHingeBaseCentred</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>FlatHingePlateBaseCentred</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>MotorAdvancedRotor</TypeId>
          <SubtypeId>AWGFlatHingeHead</SubtypeId>
        </BlockVariant>
      </BlockVariants>
    </Definition>

