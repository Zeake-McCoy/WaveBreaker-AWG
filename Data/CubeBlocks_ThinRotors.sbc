<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_MotorStatorDefinition">
      <Id>
        <TypeId>MotorStator</TypeId>
        <SubtypeId>AWGHalfRotor</SubtypeId>
      </Id>
      <DisplayName>AWG's Half Rotor</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\AWG'sHalfRotor.png</Icon>
      <Description>Description_Rotor</Description>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\AWGHalfRotorEvenWidth.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="3" />
        <Component Subtype="Construction" Count="5" />
        <Component Subtype="SmallTube" Count="1" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <BlockPairName>AWGHalfRotorPart</BlockPairName>
      <BlockVariants>
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGHalfRotorEvenWidth</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGHalfRotorDualEvenWidth</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBase</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseVertOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseVertOffsetCornerFurther1</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseVertOffsetCornerFurther2</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseVertOffsetFurther</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseCornerOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseCornerOffsetFurther</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseEven</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseDualEven</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseQuarterOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseBlockOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseEvenQuarterOffset</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGFlatRotorBaseEvenBlockOffset</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>MotorAdvancedRotor</TypeId>
          <SubtypeId>AWGFlatRotorHead</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>MotorStator</TypeId>
          <SubtypeId>AWGCubeRotor</SubtypeId>
        </BlockVariant>
        
      </BlockVariants>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <PrimarySound>BlockRotorSmall</PrimarySound>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>0.0002</RequiredPowerInput>
      <MaxForceMagnitude>1E6</MaxForceMagnitude>
      <DangerousTorqueThreshold>448000</DangerousTorqueThreshold>
      <RotorPart>MotorRotor</RotorPart>
      <RotorDisplacementMin>-0.33</RotorDisplacementMin>
      <RotorDisplacementMax>0.15</RotorDisplacementMax>
      <RotorDisplacementMinSmall>-0.33</RotorDisplacementMinSmall>
      <RotorDisplacementMaxSmall>0.15</RotorDisplacementMaxSmall>
      <RotorDisplacementInModel>0</RotorDisplacementInModel>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>100</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

