  <CubeBlocks>
    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>SlopedCornerBase100mm</SubtypeId>
      </Id>
      <DisplayName>AWG 100mm Sloped Corner Base (Misc Slopes)</DisplayName>
      <Icon>NewIcons\MiscSlopes100.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <UseModelIntersection>true</UseModelIntersection>
      <Model>Models\Cubes\Small\AWGSlopedCornerBase.mwm</Model>
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <Components>
        <Component Subtype="SteelPlate" Count="8" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>5</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      <PCU>1</PCU>
      <BlockVariants>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlopedCornerTip100mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlopedCorner100mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>SlabRaisedCornerSplit100mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>InvertedCornerTip100mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>InvertedCornerBase100mm</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
