<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<Sounds>
    <Sound>
      <Id>
        <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
        <SubtypeId>RaptorLoopASL</SubtypeId>
      </Id>
      <Category>SHIP_JET</Category>
      <MaxDistance>300</MaxDistance>
      <PitchVariation>10</PitchVariation>
      <Volume>2</Volume>
      <DistantSounds>
        <DistantSound DistanceCrossfade="100" Distance="150" Sound="RaptorLoopDistantASL" />
        <DistantSound DistanceCrossfade="100" Distance="800" Sound="RaptorLoopVeryFarASL" />
      </DistantSounds>
      <Loopable>true</Loopable>
      <UpdateDistance>300</UpdateDistance>
      <RealisticFilter>realShipFilter</RealisticFilter>
      <Waves>
        <Wave Type="D3">
          <Start>Audio\ARC\SHIP\RaptorStartASL.wav</Start>
          <Loop>Audio\ARC\SHIP\RaptorLoopASL.wav</Loop>
          <End>Audio\ARC\SHIP\RaptorStopASL.wav</End>
        </Wave>
      </Waves>
    </Sound>

    <Sound>
      <Id>
        <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
        <SubtypeId>RaptorLoopDistantASL</SubtypeId>
      </Id>
      <Category>SHIP_JET</Category>
      <MaxDistance>2500</MaxDistance>
      <PitchVariation>10</PitchVariation>
      <Volume>1</Volume>
      <Loopable>true</Loopable>
      <UpdateDistance>2500</UpdateDistance>
      <RealisticFilter>realShipFilter</RealisticFilter>
      <Waves>
        <Wave Type="D3">
          <Loop>Audio\ARC\SHIP\RaptorLoopFar.wav</Loop>
        </Wave>
      </Waves>
    </Sound>

    <Sound>
      <Id>
        <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
        <SubtypeId>RaptorLoopVeryFarASL</SubtypeId>
      </Id>
      <Category>SHIP_JET</Category>
      <MaxDistance>5000</MaxDistance>
      <PitchVariation>10</PitchVariation>
      <Volume>3</Volume>
      <Loopable>true</Loopable>
      <UpdateDistance>5000</UpdateDistance>
      <RealisticFilter>realShipFilter</RealisticFilter>
      <Waves>
        <Wave Type="D3">
          <Loop>Audio\ARC\SHIP\RaptorLoopVeryFar.wav</Loop>
        </Wave>
      </Waves>
    </Sound>
	</Sounds>
</Definitions>