      <ModelOffset x="0" y="0" z="0"/>
      <Model>Models\CupolaRimMantlet.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="1"/>
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <BlockPairName>CupolaRimMantlet2x2</BlockPairName>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
    </Definition>



    <Definition>
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>CupolaRimMantletBelow</SubtypeId>
      </Id>
      <ModelOffset x="0.5" y="-0.5" z="0" />
