<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>



    <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>AllAroundCupola2x2</SubtypeId>
      </Id>
      <DisplayName>Direct-Vision Cupola</DisplayName>
      <Description>Openable Cupola, use with Forward Offset Seat.</Description>
      <Icon>NewIcons\AllAroundVisionCupola.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\AllAroundCupola2x2.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="8" />
        <Component Subtype="Motor" Count="2" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>6</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion>
      <DisassembleRatio>1.5</DisassembleRatio>
      <PowerConsumptionIdle>0</PowerConsumptionIdle>
      <PowerConsumptionMoving>0</PowerConsumptionMoving>
      <UseModelIntersection>true</UseModelIntersection>

      <Subparts>
        <SubpartDefinition>
          <Name>AllAroundVisionCupolaSubpart</Name>
        </SubpartDefinition>
      </Subparts>
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs>
          <Move>Rotate</Move>
          <!--Slide for linear-->
          <RotationAxis>X</RotationAxis>
          <PivotPosition x="0" y="-0.045" z="0.35"/>
          <MaxOpen>150</MaxOpen>
          <Speed>100</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
      <PCU>10</PCU>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>

      <BlockVariants>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>AllAroundCupola2x2Offset</SubtypeId>
        </BlockVariant>
      <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>AllAroundCupola2x2Centred</SubtypeId>
        </BlockVariant>
    
      </BlockVariants>
    </Definition>


