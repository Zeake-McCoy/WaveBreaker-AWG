<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_AdvancedDoorDefinition">
      <Id>
        <TypeId>AdvancedDoor</TypeId>
        <SubtypeId>TankHatch1x1RoundCentre</SubtypeId>
      </Id>
      <DisplayName>AWG 1x1 Tank Hatch (Centre)</DisplayName>
      <Description>Openable tank hatch</Description>
      <Icon>NewIcons\HatchDoor1x1.png</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\TankHatch1x1RoundCentre.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="2" />
        <Component Subtype="Computer" Count="1" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0"/>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>6</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DisassembleRatio>1.5</DisassembleRatio>
      <PowerConsumptionIdle>0</PowerConsumptionIdle>
      <PowerConsumptionMoving>0</PowerConsumptionMoving>
      <UseModelIntersection>true</UseModelIntersection>
      <Subparts>
        <SubpartDefinition>
          <Name>TankHatch1x1SquareRoundedDoor</Name>
        </SubpartDefinition>
      </Subparts>
      <OpeningSequence>
        <Opening>
          <IDs>0</IDs>
          <Move>Rotate</Move>
          <!--Slide for linear-->
          <RotationAxis>Z</RotationAxis>
          <PivotPosition x="0.25215" y="0.0352" z="0"/>
          <MaxOpen>-135</MaxOpen>
          <Speed>100</Speed>
          <OpenDelay>0</OpenDelay>
          <CloseDelay>0</CloseDelay>
          <OpenSound></OpenSound>
          <CloseSound></CloseSound>
        </Opening>
      </OpeningSequence>
      <PCU>10</PCU>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>

      <MountPoints>
        <MountPoint Side="Left" StartX="0.1" EndX="0.9" StartY="0.0" EndY="1.0" />
        <MountPoint Side="Right" StartX="0.1" EndX="0.9" StartY="0.0" EndY="1.0" />
        <MountPoint Side="Front" StartX="0.0" EndX="1.0" StartY="0.1" EndY="0.9" />
        <MountPoint Side="Back" StartX="0.0" EndX="1.0" StartY="1.0" EndY="0.1" />
      </MountPoints>

      <BlockVariants>
        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankHatch1x1Round</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankHatch2x2RoundCentre</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankHatch2x2Round</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankDoor3x4Flat</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankSideAccessDoor3x4Flat</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankDoor3x4Centred</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankDoor2x1</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>TankDoor2x1Centred</SubtypeId>
        </BlockVariant>
        
        <BlockVariant>
          <TypeId>AdvancedDoor</TypeId>
          <SubtypeId>StowageOpenableHalf</SubtypeId>
        </BlockVariant>
      </BlockVariants>
    </Definition>

