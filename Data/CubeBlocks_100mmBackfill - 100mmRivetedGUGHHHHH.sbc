  <CubeBlocks>
    <Definition>
      
      <Id>
        <TypeId>CubeBlock</TypeId>
        <SubtypeId>Slope1x1Side100mm</SubtypeId>
      </Id>
      
      <DisplayName>100mm Slope 1x1 Side (100mm Backfill Group)</DisplayName>
      <Icon>NewIcons\Plate100.png</Icon><!--PlaceHolderPlate-->
      
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\Slope1x1Side100mm.mwm</Model>
      
      <IsStandAlone>true</IsStandAlone>
      <HasPhysics>true</HasPhysics>
      <UseModelIntersection>true</UseModelIntersection>
      
      <Components>
        <Component Subtype="SteelPlate" Count="8" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      
      <MirroringX>ZMinusHalfX</MirroringX>
      <MirroringY>XHalfX</MirroringY>
      <MirroringZ>HalfX</MirroringZ>
      
      <EdgeType>Light</EdgeType>
      
      <BuildTimeSeconds>5</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <DestroyEffect>AWGPlateBreakEffect</DestroyEffect>
      <DestroySound>PoofExplosionCat1</DestroySound>
      
      <PCU>1</PCU>

