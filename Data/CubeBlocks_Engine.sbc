        <Component Subtype="Computer" Count="1" />
        <Component Subtype="PowerCell" Count="1" />
        <Component Subtype="Construction" Count="8" />
        <Component Subtype="SteelPlate" Count="16" />
      </Components>
      <BlockVariants>
        <BlockVariant>
          <TypeId>HydrogenEngine</TypeId>
          <SubtypeId>AWGSmallHydro</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>HydrogenEngine</TypeId>
          <SubtypeId>AWGModularHydro</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>HydrogenEngine</TypeId>
          <SubtypeId>AWGMediumHydro</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>HydrogenEngine</TypeId>
          <SubtypeId>AWGSHEngine</SubtypeId>
        </BlockVariant>

        <BlockVariant>
          <TypeId>HydrogenEngine</TypeId>
          <SubtypeId>AWGRadial</SubtypeId>
        </BlockVariant>
        <BlockVariant>
          <TypeId>CubeBlock</TypeId>
          <SubtypeId>AWGRadialCowling</SubtypeId>
        </BlockVariant>
      </BlockVariants>
      <CriticalComponent Subtype="PowerCell" Index="0" />
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>28</BuildTimeSeconds>
      <DamageMultiplierExplosion>1</DamageMultiplierExplosion> 
      <ResourceSinkGroup>Generators</ResourceSinkGroup>
      <ResourceSourceGroup>Reactors</ResourceSourceGroup>
      <MaxPowerOutput>1.75</MaxPowerOutput>
      <FuelCapacity>16000</FuelCapacity>
      <IsAirTight>false</IsAirTight>
      <InventorySize>
        <X>1</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <FuelInfos>
        <FuelInfo>
          <Id>
            <TypeId>GasProperties</TypeId>
            <SubtypeId>Hydrogen</SubtypeId>
          </Id>
        </FuelInfo>
      </FuelInfos>
